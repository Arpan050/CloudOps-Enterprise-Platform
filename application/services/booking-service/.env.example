NODE_ENV=development
PORT=3002
POSTGRES_DB=cloudops_booking
POSTGRES_USER=cloudops_booking
POSTGRES_PASSWORD=replace_with_secure_password
DATABASE_URL=postgres://cloudops_booking:replace_with_secure_password@127.0.0.1:5434/cloudops_booking
JWT_SECRET=replace_with_auth_service_jwt_secret
AWS_REGION=ap-south-1
BOOKING_EVENTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/000000000000/cloudops-booking-events
OUTBOX_POLL_INTERVAL_MS=2000
