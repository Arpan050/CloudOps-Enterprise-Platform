NODE_ENV=development
PORT=3001

POSTGRES_DB=cloudops_auth
POSTGRES_USER=cloudops_auth
POSTGRES_PASSWORD=replace_with_random_password

DATABASE_URL=postgres://cloudops_auth:replace_with_random_password@127.0.0.1:5433/cloudops_auth

JWT_SECRET=replace_with_random_64_character_secret
JWT_EXPIRES_IN=15m

BCRYPT_ROUNDS=12